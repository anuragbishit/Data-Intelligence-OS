APP_NAME="Data Intelligence OS"
ENVIRONMENT=production
DEBUG=False

# For a real deployment, set to your actual domain
CORS_ORIGINS=http://localhost

# Database
POSTGRES_USER=ada_prod
POSTGRES_PASSWORD=SuperSecretProdPassword123!
POSTGRES_DB=ada_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# LLM Config (Google Gemini)
LLM_PROVIDER=google
GOOGLE_API_KEY=YOUR_API_KEY_HERE
GOOGLE_MODEL=gemini-2.5-flash

# Simple Single-User Admin Password
ADMIN_PASSWORD=admin
